{
  "name": "cnms-backend",
  "version": "1.0.0",
  "description": "College Newsletter Management System - Backend",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:unit": "jest --testPathPattern=unit --detectOpenHandles --forceExit",
    "test:integration": "jest --testPathPattern=integration --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write src"
  },
  "keywords": [
    "newsletter",
    "college",
    "management",
    "events"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "2.4.3",
    "bull": "4.11.4",
    "cors": "2.8.5",
    "csv-stringify": "^6.4.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "4.18.2",
    "express-rate-limit": "7.0.0",
    "express-validator": "^7.3.2",
    "groq-sdk": "^1.3.0",
    "helmet": "7.1.0",
    "image-size": "^2.0.2",
    "ioredis": "^6.0.0",
    "joi": "17.11.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.13.0",
    "qrcode": "^1.5.4",
    "redis": "4.6.11",
    "socket.io": "4.7.2",
    "speakeasy": "^2.0.0",
    "winston": "3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "8.53.0",
    "jest": "29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "3.0.1",
    "prettier": "3.1.0",
    "supertest": "6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000
  }
}
